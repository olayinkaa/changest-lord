{
	"name": "myChangeBackend",
	"version": "1.0.0",
	"description": "",
	"main": "index.js",
	"scripts": {
		"build": "prisma generate && tsc && tsc-alias",
		"start": "node dist/index.js",
		"dev": "dotenv -e .env -- tsx watch src/index.ts",
		"dev:local": "dotenv -e .env.local -- tsx watch src/index.ts",
		"dev:staging": "dotenv -e .env.staging -- tsx watch src/index.ts",
		"dev:clean": "rm -rf dist",
		"worker:start": "node dist/worker.js",
		"worker:dev": "dotenv -e .env -- tsx watch src/worker.ts",
		"worker:dev:local": "dotenv -e .env.local -- tsx watch src/worker.ts",
		"worker:dev:staging": "dotenv -e .env.staging -- tsx watch src/worker.ts",
		"dev:all": "concurrently --kill-others -n \"API,WORKER\" -c \"cyan,magenta\" \"pnpm run dev\" \"pnpm run worker:dev\"",
		"lint:check:fix": "biome check --write ./src",
		"docs:check": "tsx scripts/docs-check.ts",
		"prepare": "husky"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
