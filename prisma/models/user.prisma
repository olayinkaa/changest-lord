model User {
    id               String        @id @default(uuid())
    email            String        @unique
    phone            String        @unique
    firstName        String
    lastName         String
    middleName       String?
    isMarketer       Boolean?      @default(false)
    userType         UserType
    businessLocation String?
    businessName     String?
    address          String?
    nin              String?
    bvn              String?
    businessTypeId   String?
    businessType     BusinessType? @relation(fields: [businessTypeId], references: [id], onDelete: SetNull)
    kyc              UserKyc?
    userId5          String?       @unique
    pinHash          String?
    latitude         Decimal?      @db.Decimal(9, 6)
    longitude        Decimal?      @db.Decimal(9, 6)
    deviceBindingId  String?
    virtualAccountNo String?       @unique
    createdAt        DateTime      @default(now())
    updatedAt        DateTime      @updatedAt
    device           UserDevice?

    @@index([email])
    @@index([phone])
    @@map("users")
}

model UserKyc {
    id               String  @id @default(uuid())
    userId           String  @unique
    user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
    livenessDone     Boolean @default(false)
    completedProfile Boolean @default(false)
    emailVerified    Boolean @default(false)
    phoneVerified    Boolean @default(false)
    ninVerified      Boolean @default(false)
    locationVerified Boolean @default(false)
    whatsappVerified Boolean @default(false)
    pinCreated       Boolean @default(false)
    isSmsVerified    Boolean @default(false)

    @@map("user_kycs")
}

model UserDevice {
    id          String   @id @default(uuid())
    userId      String   @unique
    user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    deviceId    String   @unique
    deviceToken String?
    lastUsedAt  DateTime @default(now())
    createdAt   DateTime @default(now())

    @@map("user_devices")
}
