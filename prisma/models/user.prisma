model User {
    id                String   @id @default(uuid())
    email             String?  @unique
    phone             String   @unique
    firstName         String?
    lastName          String?
    middleName        String?
    isMarketer        Boolean  @default(false)
    role              UserRole @default(user)
    businessCategory String?
    businessName     String?
    address           String?
    nin               String?
    bvn               String?
    businessTypeId   String?
    businessType       BusinessType? @relation(fields: [businessTypeId], references: [id], onDelete: SetNull)
    kyc               UserKyc?
    createdAt         DateTime @default(now())
    updatedAt         DateTime @updatedAt

    @@index([email])
    @@index([phone])
    @@map("users")
}

model UserKyc {
    id               String  @id @default(uuid())
    userId           String  @unique
    user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
    livenessDone     Boolean @default(false)
    completedProfile Boolean @default(false)
    emailVerified    Boolean @default(false)
    phoneVerified    Boolean @default(false)
    ninVerified      Boolean @default(false)
    locationVerified Boolean @default(false)
    whatsappVerified Boolean @default(false)
    createdPin       Boolean @default(false)
}
