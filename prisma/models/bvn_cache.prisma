model BvnCache {
    id        String   @id @default(uuid())
    bvn       String   @unique
    firstName String?
    lastName  String?
    dob       String? // Date of birth
    phone     String?
    image     String? // Base64 or image URL returned by Dojah
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("bvn_caches")
}
