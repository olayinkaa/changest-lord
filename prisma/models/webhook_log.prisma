model WebhookLog {
  id        String        @id @default(uuid())
  userId    String?
  event     String
  payload   Json
  response  Json?
  error     Json?
  status    WebhookStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("webhook_logs")
}
